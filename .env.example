POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres

TARGET_LLM_BASE_URL=http://host.docker.internal:9000/v1
TARGET_LLM_API_KEY=test-key
#layer 3 reasoning judge (OpenAI-compatible local model server).
#============GROQ==========
LLM_PROVIDER=groq
LAYER3_BASE_URL=https://api.groq.com/openai/v1
LAYER3_MODEL=openai/gpt-oss-120b
LLM_API_KEY=INSERT_YOUR_GROQ_API_KEY_HERE
#============END GROQ==========
# Gateway -> PostgreSQL connection string. Keep host 'db' for Docker Compose.
#DATABASE_URL=postgresql+asyncpg://firewall_user:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@db:5432/firewall_db

# Host port published for the OpenAI-compatible firewall API.
PROXY_PORT=8000

# Downstream LLM provider called only after a request passes inspection.
# Use your provider's OpenAI-compatible /v1 endpoint. A real provider key is not required
# for startup or blocked-request tests, but clean requests need a reachable provider.
TARGET_LLM_BASE_URL=http://host.docker.internal:9000/v1
TARGET_LLM_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
DOWNSTREAM_TIMEOUT_SECONDS=30

# Layer 3 reasoning judge (OpenAI-compatible local model server).
# Inside a container, localhost refers to that container; use host.docker.internal
# where supported, or a reachable host/LAN address for your model server.

# Layer 2 local ONNX classifier. Defaults match the repository model locations.
L2_MODEL_PATH=src/models/classifier.onnx
L2_TOKENIZER_DIR=src/models/tokenizer
L2_MAX_LENGTH=512
L2_INJECTION_LABEL_INDEX=1

# Firewall configuration and runtime-editable dashboard overlay.
FIREWALL_CONFIG_PATH=config/firewall.yaml
# This file must be writable by the container user if dashboard edits are enabled.
FIREWALL_RUNTIME_CONFIG_PATH=/app/config/runtime-firewall.yaml

# Dashboard configuration. Use a strong unique password; the dashboard is not
# intended to be exposed directly to the public internet.
DASHBOARD_ADMIN_PASSWORD=passwrod@123

# Operational tuning. RULES_POLL_SECONDS controls Layer 1 rule refresh;
# ROLLUP_INTERVAL_SECONDS controls analytics aggregation cadence.
RULES_POLL_SECONDS=5
ROLLUP_INTERVAL_SECONDS=300
# Inspection failure policy: false = fail closed (recommended); true = fail open.
FIREWALL_FAIL_OPEN=false

# Performance-test thresholds and output. These are test-only; do not set them
# unless running tests/perf. Results are written locally and should not be committed.
PERF_L1_P95_MS=1
PERF_L2_P95_MS=30
PERF_PROXY_OVERHEAD_P95_MS=20
PERF_RESULTS_DIR=./perf_results
PERF_RULES_POLL_SECONDS=1.0
PERF_CONFIG_POLL_SECONDS=1.0
PERF_RELOAD_MARGIN_S=1.0
PERF_SWAP_P95_FACTOR=3.0
PERF_LOAD_WORKERS=4
PERF_PHASE_SECONDS=2.0
PERF_SWAP_INTERVAL_S=0.0005
